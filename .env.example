# Copy to .env and fill in. `.env` is gitignored; this file is the documentation.
#
#   cp .env.example .env
#
# Real environment variables always win over .env, so a deployed secret is
# never shadowed by a stale local file. Every default below reproduces the
# behaviour the README's published numbers were measured with -- an unset
# variable can never silently change a result.

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------

# Needed only for `--live` runs. Without it, everything falls back to the
# deterministic baseline policy and no network call is made.
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Trace persistence
# ---------------------------------------------------------------------------

# Where investigation traces go: none | jsonl | postgres
# Defaults to `postgres` when TRACE_DSN is set, otherwise `jsonl`.
# TRACE_BACKEND=jsonl

# JSONL backend: append one JSON object per investigation here.
# TRACE_PATH=results/traces.jsonl

# Postgres backend. DATABASE_URL is accepted as an alias, so most hosted
# providers (Neon, Supabase, Railway, RDS) work with the string they give you.
# Managed providers usually require TLS -- keep the sslmode parameter.
# TRACE_DSN=postgresql://user:password@host:5432/dbname?sslmode=require

# Table name. Created by: python -m src.agent.traces init
# TRACE_TABLE=agent_traces

# Set to false to store tool arguments but NOT tool results. Results are the
# most useful part of a trace and also the bulkiest; turn this off if rows get
# large or if telemetry payloads would be sensitive in your deployment.
# TRACE_INCLUDE_TOOL_RESULTS=true

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# AGENT_MODEL=claude-opus-5
# AGENT_EFFORT=high                  # low | medium | high | xhigh | max
# AGENT_MAX_TOKENS=16000

# Used only to compute cost_usd on traces and eval reports. Update these when
# pricing changes rather than editing code.
# AGENT_INPUT_USD_PER_MTOK=5.00
# AGENT_OUTPUT_USD_PER_MTOK=25.00

# ---------------------------------------------------------------------------
# Agent loop budgets
# ---------------------------------------------------------------------------

# AGENT_MAX_STEPS=8
# AGENT_MAX_TOOL_CALLS=16
# AGENT_MAX_OUTPUT_TOKENS=40000
# AGENT_WALL_SECONDS=300
# AGENT_MAX_TOOL_ERRORS=3            # consecutive errors before the loop stops
# AGENT_REPAIR_ATTEMPTS=1            # retries on an unparseable final answer

# ---------------------------------------------------------------------------
# Prompt and memory
# ---------------------------------------------------------------------------

# Prompt version from src/agent/prompts.py. Unset uses the registry default.
# AGENT_PROMPT_VERSION=v2-procedural

# AGENT_MEMORY_ENABLED=true
# AGENT_MEMORY_PATH=results/memory.json   # unset keeps memory in-process only
# AGENT_MEMORY_RECALL_K=3
# AGENT_MEMORY_MIN_SUPPORT=2              # episodes before a semantic memory forms

# ---------------------------------------------------------------------------
# Routing constraints (the closed loop)
# ---------------------------------------------------------------------------

# CONSTRAINT_TTL_MINUTES=480
# CONSTRAINT_CANARY_RATE=0.02        # never set to 0 in production: a fully
#                                    # blocked gateway stops producing the
#                                    # observations needed to ever unblock it
# CONSTRAINT_MIN_CONFIDENCE=0.6      # below this, a diagnosis moves no traffic

# ---------------------------------------------------------------------------
# Run labelling
# ---------------------------------------------------------------------------

# Free-text tag stored on every trace. Useful for slicing a stored run later
# (git SHA, experiment name, CI build number).
# AGENT_RUN_LABEL=local
# TRACE_CONNECT_TIMEOUT=5              # seconds; an unreachable DB degrades to "no traces"
